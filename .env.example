# Django
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,blog.example.com
CSRF_TRUSTED_ORIGINS=https://blog.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_X_FORWARDED_HOST=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=replace-blog-password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# Cache / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=replace-rabbitmq-password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# API security
HEALTH_CHECK_TOKEN=replace-with-internal-health-token
API_ANON_THROTTLE_RATE=120/hour
API_USER_THROTTLE_RATE=600/hour
API_PUBLIC_CONTENT_THROTTLE_RATE=240/hour
API_SEARCH_THROTTLE_RATE=30/hour
API_HEALTH_THROTTLE_RATE=30/hour
API_PUBLIC_HEALTH_THROTTLE_RATE=120/hour
DRF_NUM_PROXIES=1
DJANGO_LOG_LEVEL=INFO
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Search
SEARCH_BACKEND=database
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=content

# Analytics
ANALYTICS_PROVIDER=
ANALYTICS_SITE=
ANALYTICS_DASHBOARD_URL=
ANALYTICS_API_BASE_URL=
ANALYTICS_API_KEY=
ANALYTICS_API_AUTH_TYPE=auto
ANALYTICS_TIMEOUT_SECONDS=5
